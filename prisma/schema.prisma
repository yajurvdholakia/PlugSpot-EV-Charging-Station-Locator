// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String
  role      String   @default("USER") // USER | ADMIN
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reviews      Review[]
  favorites    Favorite[]
}

model Station {
  id             String   @id @default(cuid())
  name           String
  operator       String   // Tata Power, Ather Grid, ChargeZone, Statiq, etc.
  address        String
  area           String   // e.g. "Infocity", "Satellite", "Bodakdev"
  city           String   // Gandhinagar | Ahmedabad
  state          String   @default("Gujarat")
  lat            Float
  lng            Float
  status         String   @default("OPERATIONAL") // OPERATIONAL | MAINTENANCE | OFFLINE
  connectorTypes String   // CSV: "CCS,Type2,CHAdeMO,BharatAC"
  powerKW        Float    // total power in kW
  pricePerKWh    Float    // price in INR
  numberOfPorts  Int      @default(1)
  availablePorts Int      @default(1)
  amenities      String   // CSV: "Restroom,Cafe,Wifi,Parking,ATM"
  hours          String   @default("24/7")
  phone          String?
  image          String?
  rating         Float    @default(0)
  reviewCount    Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  reviews      Review[]
  favorites    Favorite[]
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  stationId String
  rating    Int // 1-5
  comment   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  station Station @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@unique([userId, stationId])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  stationId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  station Station @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@unique([userId, stationId])
}

